@baseUrl = http://localhost:8080
@userId =
@mailId =

### Create user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "max.mustermann@example.com",
  "firstName": "Max",
  "lastName": "Mustermann",
  "password": "Password123!"
}

### Get all users
GET {{baseUrl}}/users

### Get user by id
GET {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227

### Create draft mail
POST {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails
Content-Type: application/json

{
  "sender": "max.mustermann@example.com",
  "to": "anna@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Test Mail",
  "body": "Hallo, das ist eine Test Mail."
}

### Get all mails of user
GET {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails

### Get mail by id
GET {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails/d558e8a7-daf6-46c6-99d7-8a3a3be45321

### Send draft mail
POST {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails/d558e8a7-daf6-46c6-99d7-8a3a3be45321/send

### Send same draft again - should fail
POST {{baseUrl}}/users/{{userId}}/mails/{{mailId}}/send


### Create another draft mail for update/delete tests
POST {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails
Content-Type: application/json

{
  "sender": "max.mustermann@example.com",
  "to": "anna@example.com",
  "cc": "",
  "bcc": "",
  "subject": "Draft zum Bearbeiten",
  "body": "Dieser Draft wird gleich geändert."
}

### Update draft mail
PUT {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails/1aa64366-9fb9-4546-a6ed-f8612953bcdd
Content-Type: application/json

{
  "sender": "max.mustermann@example.com",
  "to": "anna.neu@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Geänderter Draft",
  "body": "Dieser Draft wurde erfolgreich geändert."
}

### Delete mail
DELETE {{baseUrl}}/users/a6fb3f59-eb6d-4c02-a27b-01d243121227/mails/1aa64366-9fb9-4546-a6ed-f8612953bcdd

### Get deleted mail - should fail with 404
GET {{baseUrl}}/users/1dfa597c-7a06-41df-b96f-ec1a9a2ee4d4/mails/{{mailId}}

### Delete already deleted mail - should fail with 404
DELETE {{baseUrl}}/users/1dfa597c-7a06-41df-b96f-ec1a9a2ee4d4/mails/{{mailId}}

### Get all mails after delete
GET {{baseUrl}}/users/f8011426-1bcd-40a6-8e7b-51bcc63d3bf7/mails