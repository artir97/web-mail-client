@baseUrl = http://localhost:8080

# Nach dem Create User hier eintragen
@userId = a6fb3f59-eb6d-4c02-a27b-01d243121227

# Nach dem Create Draft hier eintragen
@mailId = d558e8a7-daf6-46c6-99d7-8a3a3be45321

# Nach dem zweiten Create Draft hier eintragen
@draftId = 1aa64366-9fb9-4546-a6ed-f8612953bcdd


### Create user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "max.mustermann@example.com",
  "firstName": "Max",
  "lastName": "Mustermann",
  "password": "Password123!"
}


### Get all users
GET {{baseUrl}}/users


### Get user by id
GET {{baseUrl}}/users/{{userId}}


### Create draft mail
POST {{baseUrl}}/users/{{userId}}/mails
Content-Type: application/json

{
  "sender": "max.mustermann@example.com",
  "to": "anna@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Test Mail",
  "body": "Hallo, das ist eine Test Mail."
}


### Get all mails of user
GET {{baseUrl}}/users/{{userId}}/mails


### Get mail by id
GET {{baseUrl}}/users/{{userId}}/mails/{{mailId}}


### Send draft mail
POST {{baseUrl}}/users/{{userId}}/mails/{{mailId}}/send


### Send same draft again - should fail with 400
POST {{baseUrl}}/users/{{userId}}/mails/{{mailId}}/send


### Create another draft mail for update/delete tests
POST {{baseUrl}}/users/{{userId}}/mails
Content-Type: application/json

{
  "sender": "max.mustermann@example.com",
  "to": "anna@example.com",
  "cc": "",
  "bcc": "",
  "subject": "Draft zum Bearbeiten",
  "body": "Dieser Draft wird gleich geändert."
}


### Update draft mail
PUT {{baseUrl}}/users/{{userId}}/mails/{{draftId}}
Content-Type: application/json

{
  "sender": "max.mustermann@example.com",
  "to": "anna.neu@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Geänderter Draft",
  "body": "Dieser Draft wurde erfolgreich geändert."
}


### Get updated draft
GET {{baseUrl}}/users/{{userId}}/mails/{{draftId}}


### Delete mail
DELETE {{baseUrl}}/users/{{userId}}/mails/{{draftId}}


### Get deleted mail - should fail with 404
GET {{baseUrl}}/users/{{userId}}/mails/{{draftId}}


### Delete already deleted mail - should fail with 404
DELETE {{baseUrl}}/users/{{userId}}/mails/{{draftId}}


### Get all mails after delete
GET {{baseUrl}}/users/{{userId}}/mails