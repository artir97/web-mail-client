@baseUrl = http://localhost:8080

# Real users fetched from the local app on 2026-06-05.
@userId = 0153b08a-c8ea-4fb8-8217-f2737e60ddbf
@userId2 = d7ba81de-8f01-41ec-aa67-1bd5de36d18d

# Fresh JWTs from the local app. Re-run the login requests when they expire.
@tokenA = eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiIwMTUzYjA4YS1jOGVhLTRmYjgtODIxNy1mMjczN2U2MGRkYmYiLCJlbWFpbCI6Im1heC5tdXN0ZXJtYW5uQGV4YW1wbGUuY29tIiwiaWF0IjoxNzgwOTkzMTk2LCJleHAiOjE3ODA5OTY3OTZ9.Y0DUME0DNs9rCl0VyY9_-6ywRqu8ERjFBty8VzCqeogJAwKrpVZC97sUlxytpl4u
@tokenB = eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJkN2JhODFkZS04ZjAxLTQxZWMtYWE2Ny0xYmQ1ZGUzNmQxOGQiLCJlbWFpbCI6Im1heDIubXVzdGVybWFubkBleGFtcGxlLmNvbSIsImlhdCI6MTc4MDc0Nzc4NywiZXhwIjoxNzgwNzUxMzg3fQ.O3mKeVb5m0UwhgGzUGt26kyG2rGgqXMJ_JBbVUq3kz64jt9qRYb0oNbkzHQyf5zJ

# Existing draft for User A. After request 09, copy the returned id here
# when you want the later mail-id requests to use the newly created draft.
@mailId = ad9554f4-951d-4a6c-a84c-9600163e3b44
@draftId = ad9554f4-951d-4a6c-a84c-9600163e3b44

@userAEmail = max.mustermann@example.com
@userAPassword = Password123!

@userBEmail = max2.mustermann@example.com
@userBPassword = Password1234!


### 01 Create User A - expected 201 Created, or 409 Conflict if already exists
# Observed on current local app when already exists: 403 Forbidden.
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "{{userAEmail}}",
  "firstName": "Max",
  "lastName": "Mustermann",
  "password": "{{userAPassword}}"
}


### 02 Create User B - expected 201 Created, or 409 Conflict if already exists
# Observed on current local app when already exists: 403 Forbidden.
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "{{userBEmail}}",
  "firstName": "Max2",
  "lastName": "Mustermann2",
  "password": "{{userBPassword}}"
}


### 03 Login User A - expected 200 OK
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userAEmail}}",
  "password": "{{userAPassword}}"
}


### 04 Login User B - expected 200 OK
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "{{userBEmail}}",
  "password": "{{userBPassword}}"
}


### 05 Access protected endpoint without token - expected 403 Forbidden
GET {{baseUrl}}/users


### 06 Access protected endpoint with tokenA - expected 200 OK
GET {{baseUrl}}/users
Authorization: Bearer {{tokenA}}


### 07 Get User A mails with tokenA - expected 200 OK
GET {{baseUrl}}/users/{{userId}}/mails
Authorization: Bearer {{tokenA}}


### 08 Get User B mails with tokenA - expected 403 Forbidden
GET {{baseUrl}}/users/{{userId2}}/mails
Authorization: Bearer {{tokenA}}


### 09 Create draft for User A with tokenA - expected 201 Created
POST {{baseUrl}}/users/{{userId}}/mails
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "sender": "{{userAEmail}}",
  "to": "anna@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Authorization Test Draft A",
  "body": "Created by authorization test."
}


### 10 Create draft for User B with tokenA - expected 403 Forbidden
POST {{baseUrl}}/users/{{userId2}}/mails
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "sender": "{{userBEmail}}",
  "to": "anna@example.com",
  "cc": "",
  "bcc": "",
  "subject": "Authorization Test Draft B blocked",
  "body": "This must be blocked because tokenA belongs to User A."
}


### 11 Create draft for User B with tokenB - expected 201 Created
POST {{baseUrl}}/users/{{userId2}}/mails
Content-Type: application/json
Authorization: Bearer {{tokenB}}

{
  "sender": "{{userBEmail}}",
  "to": "anna@example.com",
  "cc": "",
  "bcc": "",
  "subject": "Authorization Test Draft B",
  "body": "Created by authorization test."
}


### 12 Get User A mail with tokenA - expected 200 OK
GET {{baseUrl}}/users/{{userId}}/mails/{{mailId}}
Authorization: Bearer {{tokenA}}


### 13 Get User A mail through User B URL with tokenA - expected 403 Forbidden
GET {{baseUrl}}/users/{{userId2}}/mails/{{mailId}}
Authorization: Bearer {{tokenA}}


### 14 Update User A draft with tokenA - expected 200 OK
PUT {{baseUrl}}/users/{{userId}}/mails/{{draftId}}
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "sender": "{{userAEmail}}",
  "to": "anna.neu@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Updated Authorization Test Draft A",
  "body": "Updated by authorization test."
}


### 15 Update User A draft through User B URL with tokenA - expected 403 Forbidden
PUT {{baseUrl}}/users/{{userId2}}/mails/{{draftId}}
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "sender": "{{userAEmail}}",
  "to": "anna.neu@example.com",
  "cc": "team@example.com",
  "bcc": "",
  "subject": "Blocked Cross-user Update",
  "body": "This must be blocked because tokenA belongs to User A."
}


### 16 Send User A draft with tokenA - expected 200 OK
POST {{baseUrl}}/users/{{userId}}/mails/{{draftId}}/send
Authorization: Bearer {{tokenA}}


### 17 Send User A draft through User B URL with tokenA - expected 403 Forbidden
POST {{baseUrl}}/users/{{userId2}}/mails/{{draftId}}/send
Authorization: Bearer {{tokenA}}


### Extra: send same mail again after request 16 - expected 400 Bad Request
POST {{baseUrl}}/users/{{userId}}/mails/{{draftId}}/send
Authorization: Bearer {{tokenA}}


### 18 Delete User A mail with tokenA - expected 204 No Content
DELETE {{baseUrl}}/users/{{userId}}/mails/{{draftId}}
Authorization: Bearer {{tokenA}}


### 19 Delete User A mail through User B URL with tokenA - expected 403 Forbidden
DELETE {{baseUrl}}/users/{{userId2}}/mails/{{draftId}}
Authorization: Bearer {{tokenA}}


### Extra: get deleted mail after request 18 - expected 404 Not Found
GET {{baseUrl}}/users/{{userId}}/mails/{{draftId}}
Authorization: Bearer {{tokenA}}


### Extra: delete already deleted mail after request 18 - expected 404 Not Found
DELETE {{baseUrl}}/users/{{userId}}/mails/{{draftId}}
Authorization: Bearer {{tokenA}}
